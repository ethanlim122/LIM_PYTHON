LastNameSalary = {"E104":{
"EmpName": "Ethan Lim",
"DailyHrs": [8,9,8.5,10,8]
},
"E601": {
"EmpName": "Clove Reyna",
"DailyHrs": [9.10,8,8,9]
}
}
emp_id = input("Enter Employee ID: ")
if emp_id not in LastNameSalary:
    print("Not found")
else:
    employee = LastNameSalary[emp_id]
    emp_name = employee["EmpName"]
    daily_hrs = employee["DailyHrs"]

    print(f"Name:{emp_name}")
    print(f"DutyHours: {daily_hrs}")

    WeeklyBasic = 9000
    rateperhour = WeeklyBasic / 40

    Total_Weekly_Hours = sum(daily_hrs)

    overtime = 0
    for hrs in daily_hrs:
        if hrs > 8:
            excess = hrs - 8
            overtime += excess * (1.5 * rateperhour)

    GrossPay = (40 * rateperhour) + overtime

print(f"Total Weekly Hours: {Total_Weekly_Hours}")
print(f"Overtime: {overtime:2f}")
print(f"Gross Pay: {GrossPay:.2f}")
